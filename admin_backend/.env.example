# Copy to .env for manual deployment, or run scripts/intranet_deploy.sh.

# Browser/API admin token. Use a long random value.
KEYLESSPASS_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Optional role-based replacement for KEYLESSPASS_ADMIN_TOKEN.
# Roles: admin (organization/revocation), operator (device/license operations),
# auditor (status, device CSV, and audit CSV only).
# KEYLESSPASS_ADMIN_USERS_JSON=[{"name":"admin","role":"admin","token":"replace-with-at-least-24-random-characters"},{"name":"operator","role":"operator","token":"replace-with-another-long-random-token"},{"name":"auditor","role":"auditor","token":"replace-with-another-long-random-token"}]

# Customer-site Ed25519 signing seed, base64 encoded, 32 bytes after decoding.
# It may sign only bundles constrained by the vendor entitlement below.
KEYLESSPASS_LICENSE_SIGNING_KEY_B64=replace-with-base64-ed25519-seed
KEYLESSPASS_LICENSE_KEY_ID=replace-with-customer-site-key-id
KEYLESSPASS_LICENSE_ISSUER=KeyLessPass Customer Site

# Vendor root. The private root key never goes to a customer site.
# Commercial clients embed this public key and ID at build time.
KEYLESSPASS_VENDOR_KEY_ID=keylesspass-vendor-root-2026
KEYLESSPASS_VENDOR_PUBLIC_KEY_B64=replace-with-vendor-root-public-key

# Docker Compose mounts this vendor-signed file at the path below.
# Place it at admin_backend/license/customer-entitlement.json.
KEYLESSPASS_CUSTOMER_ENTITLEMENT_FILE=/license/customer-entitlement.json

# Host port for intranet deployment.
KEYLESSPASS_ADMIN_PORT=8787
