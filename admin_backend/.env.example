# Copy to .env for manual deployment, or run scripts/intranet_deploy.sh.

# Browser/API admin token. Use a long random value.
KEYLESSPASS_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Ed25519 signing seed, base64 encoded, 32 bytes after decoding.
# Generate one with:
#   cargo run -- generate-key
# or:
#   openssl rand -base64 32
KEYLESSPASS_LICENSE_SIGNING_KEY_B64=replace-with-base64-ed25519-seed

# Must match the public key embedded in commercial KeyLessPass clients.
KEYLESSPASS_LICENSE_KEY_ID=keylesspass-license-2026-q3
KEYLESSPASS_LICENSE_ISSUER=KeyLessPass Commercial Admin

# Host port for intranet deployment.
KEYLESSPASS_ADMIN_PORT=8787
