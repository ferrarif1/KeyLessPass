digraph ASTER_GA {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.25",
    nodesep="0.45",
    ranksep="2.00",
    fontname="Helvetica",
    label="ASTER: Exact-scope threshold credentials with post-compromise healing",
    labelloc="t",
    fontsize=22,
    fontcolor="#17365D"
  ];
  node [shape=box, style="rounded,filled", fixedsize=true, width=2.35, height=0.78,
        fontname="Helvetica", fontsize=12, color="#35618D", penwidth=1.5,
        margin="0.10,0.06"];
  edge [fontname="Helvetica", fontsize=11, color="#526D82", penwidth=1.5, arrowsize=0.8];

  exact [label="Exact policy space\nCount + Rank/Unrank", fillcolor="#D9EAF7"];
  auth [label="Exact-scope capability\nContext + generation", fillcolor="#FFF1CC", color="#B57F00"];
  mpc [label="Threshold evaluation\nRoot-Epoch stays shared", fillcolor="#E6F3E6", color="#3C7D44"];
  output [label="One compliant password\nNo reusable endpoint key", fillcolor="#DCEFE0", color="#3C7D44"];

  exact -> auth [label="generation g"];
  auth -> mpc [label="authorize once"];
  mpc -> output [label="release output"];

  compromise [label="Old root disclosed", fillcolor="#FBE3E3", color="#A94442"];
  epoch [label="Independent new Root-Epoch", fillcolor="#F7E7F7", color="#7E4E8A"];
  migrate [label="Evidence-bounded migration\nRetain both paths if ambiguous", fillcolor="#FFF1CC", color="#B57F00"];
  healed [label="Progressive healing\nOld-root exposure -> 0", fillcolor="#DCEFE0", color="#3C7D44"];

  compromise -> epoch [label="replace, not refresh"];
  epoch -> migrate [label="credential by credential"];
  migrate -> healed [label="commit only on evidence"];

  { rank=same; exact; auth; mpc; output; }
  { rank=same; compromise; epoch; migrate; healed; }
  exact -> compromise [style=invis, weight=10];
  auth -> epoch [style=invis, weight=10];
  mpc -> migrate [style=invis, weight=10];
  output -> healed [style=invis, weight=10];
}
